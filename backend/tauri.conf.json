{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayPulse Dev",
  "version": "../package.json",
  "identifier": "com.relaypulse.app.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build:dev",
    "frontendDist": "../frontend/dist/development"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RelayPulse Dev",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "decorations": true,
        "resizable": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 RelayPulse",
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "infoplist": ""
    },
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
