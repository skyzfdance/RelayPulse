{
  "name": "@relaypulse/frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "build:dev": "pnpm typecheck && vite build --outDir dist/development",
    "build:production": "pnpm typecheck && vite build --outDir dist/production",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@antdv-next/icons": "^1.1.2",
    "@tauri-apps/api": "^2",
    "antdv-next": "^1.6.0",
    "dayjs": "^1.11.23",
    "pinia": "^4.0.3",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antdv-next/auto-import-resolver": "^1.2.0",
    "@antdv-next/tailwind": "^1.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^24",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.12"
  }
}
