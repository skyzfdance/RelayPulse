{
  "name": "relaypulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "lint": "eslint . --max-warnings 0 && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri dev",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:info": "tauri info"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "antd": "^6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4"
  }
}
