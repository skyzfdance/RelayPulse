{
  "name": "relaypulse",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev:desktop": "node scripts/tauri.mjs dev",
    "dev:web": "pnpm --dir frontend dev",
    "build:desktop:dev": "node scripts/tauri.mjs build",
    "build:desktop:production": "node scripts/tauri.mjs build --production",
    "build:web": "pnpm --dir frontend build",
    "build:assets:dev": "pnpm --dir frontend build:dev",
    "build:assets:production": "pnpm --dir frontend build:production",
    "preview:web": "pnpm --dir frontend preview",
    "check:all": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:frontend && pnpm test:backend && pnpm test:desktop-scripts && pnpm test:e2e",
    "lint": "pnpm lint:frontend && pnpm lint:scripts && pnpm lint:backend",
    "lint:frontend": "pnpm --dir frontend lint",
    "lint:scripts": "eslint scripts --config scripts/eslint.config.js --max-warnings 0",
    "lint:backend": "cd backend && cargo clippy --all-targets --all-features -- -D warnings",
    "lint:fix": "pnpm --dir frontend lint:fix && eslint scripts --config scripts/eslint.config.js --fix --max-warnings 0",
    "format": "pnpm --dir frontend format && pnpm format:backend",
    "format:backend": "cd backend && cargo fmt --all",
    "format:check": "pnpm --dir frontend format:check && pnpm format:backend:check",
    "format:backend:check": "cd backend && cargo fmt --all -- --check",
    "typecheck": "pnpm --dir frontend typecheck",
    "test:frontend": "pnpm --dir frontend test",
    "test:frontend:watch": "pnpm --dir frontend test:watch",
    "test:backend": "cd backend && cargo test --all-features",
    "test:desktop-scripts": "node --test scripts/tests/*.test.mjs",
    "test:e2e": "pnpm --dir frontend test:e2e",
    "info:desktop": "node scripts/tauri.mjs info",
    "tauri": "node scripts/tauri.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0"
  }
}
