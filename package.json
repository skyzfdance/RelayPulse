{
  "name": "relaypulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev:desktop": "node scripts/tauri.mjs dev",
    "dev:web": "vite",
    "build:desktop:dev": "node scripts/tauri.mjs build",
    "build:desktop:production": "node scripts/tauri.mjs build --production",
    "build:web": "tsc && vite build",
    "build:assets:dev": "tsc && vite build --outDir dist-desktop/development",
    "build:assets:production": "tsc && vite build --outDir dist-desktop/production",
    "preview:web": "vite preview",
    "check:all": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:frontend && pnpm test:backend && pnpm test:desktop-scripts && pnpm test:e2e && pnpm test:visual",
    "lint": "eslint . --max-warnings 0 && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "typecheck": "tsc --noEmit",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml --all-features",
    "test:desktop-scripts": "node --test scripts/tests/*.test.mjs",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "info:desktop": "tauri info",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@tauri-apps/api": "^2",
    "antd": "^6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
